# Required for `npm run ingest` and for the server-side chat route.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional third fallback: a free key from https://openrouter.ai/keys (no card needed).
OPENROUTER_API_KEY=

# Embeddings run locally with the checked-in open-source ONNX model, so no
# embedding key or billing is needed.

# Stable generation defaults used if these values are not set.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b
# Comma-separated free models, tried in order. Each must end in ":free". OpenRouter's
# free list changes often (check https://openrouter.ai/models?q=free). Do not use
# "openrouter/free": it can route to a safety-classifier model that is not a chat model.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# Tune only after inspecting eval results. This cosine score is intentionally
# conservative: answers must have meaningful corpus support.
RAG_RELEVANCE_THRESHOLD=0.32

# Diagnostics only: set to 1 on a deployment to include the underlying error
# in failed /api/chat responses. Remove it once the problem is fixed.
# CHAT_DEBUG=1
