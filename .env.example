# Required for `npm run ingest` and for the server-side chat route.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional third fallback: a free key from https://openrouter.ai/keys (no card needed).
OPENROUTER_API_KEY=

# Embeddings run locally with the checked-in open-source ONNX model. No
# embedding key, Vertex project, service account, or billing is required.

# Stable generation defaults used if these values are not set.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b
# Must be a model ending in ":free". OpenRouter's free list changes; check https://openrouter.ai/models?q=free
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Tune only after inspecting eval results. This cosine score is intentionally
# conservative: answers must have meaningful corpus support.
RAG_RELEVANCE_THRESHOLD=0.32
