# Required for `npm run ingest` and for the server-side chat route.
GEMINI_API_KEY=
GROQ_API_KEY=

# Vertex AI embeddings. Use application-default credentials locally, or set a
# local credential-file path / one-line service-account JSON for Vercel. Keep
# both values server-side and never commit the credential file.
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_CREDENTIALS_FILE=
VERTEX_AI_CREDENTIALS=

# Stable defaults used if these values are not set.
# text-embedding-005 supports five document inputs per request and is a good
# fit for this English-only portfolio corpus.
VERTEX_EMBEDDING_MODEL=text-embedding-005
GEMINI_PRIMARY_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-20b

# Tune only after inspecting eval results. This cosine score is intentionally
# conservative: answers must have meaningful corpus support.
RAG_RELEVANCE_THRESHOLD=0.42
